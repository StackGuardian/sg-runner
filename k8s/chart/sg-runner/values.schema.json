{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sg-runner chart values",
  "type": "object",
  "definitions": {
    "quantity": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|M|Mi|G|Gi|T|Ti|P|Pi|E|Ei)?$"
    },
    "storage": {
      "type": "object",
      "required": [
        "size"
      ],
      "properties": {
        "size": {
          "$ref": "#/definitions/quantity"
        },
        "storageClassName": {
          "type": "string"
        }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": [
            "string",
            "number"
          ]
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "positiveInt": {
      "type": "integer",
      "minimum": 1
    },
    "duration": {
      "type": "string",
      "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
    },
    "envList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/quantity"
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/quantity"
          }
        }
      }
    }
  },
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string",
      "maxLength": 52
    },
    "image": {
      "allOf": [
        {
          "$ref": "#/definitions/image"
        },
        {
          "required": [
            "repository"
          ],
          "properties": {
            "repository": {
              "minLength": 1
            }
          }
        }
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "sg": {
      "type": "object",
      "properties": {
        "organization": {
          "type": "string"
        },
        "runnerGroup": {
          "type": "string"
        },
        "apiUrl": {
          "type": "string",
          "pattern": "^(https?://.+)?$"
        }
      }
    },
    "credentials": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "create": {
          "type": "boolean"
        },
        "nodeToken": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "runner": {
      "type": "object",
      "required": [
        "size"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "size": {
          "enum": [
            "small",
            "medium",
            "large",
            "custom"
          ]
        },
        "storage": {
          "type": "object",
          "properties": {
            "state": {
              "$ref": "#/definitions/storage"
            },
            "docker": {
              "$ref": "#/definitions/storage"
            }
          }
        },
        "dockerd": {
          "type": "object",
          "properties": {
            "securityContext": {
              "type": "object"
            },
            "extraEnv": {
              "$ref": "#/definitions/envList"
            }
          }
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "ecsAgent": {
          "type": "object",
          "properties": {
            "extraEnv": {
              "$ref": "#/definitions/envList"
            }
          }
        },
        "reregisterOnResize": {
          "type": "boolean"
        },
        "advertise": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "memory": {
              "type": "string",
              "pattern": "^([1-9][0-9]*(Mi|Gi))?$"
            }
          },
          "additionalProperties": false
        },
        "controllerResources": {
          "$ref": "#/definitions/resources"
        },
        "steps": {
          "type": "object",
          "properties": {
            "workspace": {
              "type": "object",
              "required": [
                "size"
              ],
              "properties": {
                "storageClassName": {
                  "type": "string"
                },
                "size": {
                  "$ref": "#/definitions/quantity"
                },
                "accessModes": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "enum": [
                      "ReadWriteOnce",
                      "ReadWriteOncePod",
                      "ReadWriteMany"
                    ]
                  }
                }
              }
            },
            "schedulingTimeout": {
              "$ref": "#/definitions/duration"
            },
            "startTimeout": {
              "$ref": "#/definitions/duration"
            },
            "finishedTTL": {
              "$ref": "#/definitions/duration"
            },
            "step": {
              "type": "object",
              "properties": {
                "nodeSelector": {
                  "type": "object"
                },
                "tolerations": {
                  "type": "array"
                },
                "imagePullPolicy": {
                  "enum": [
                    "",
                    "Always",
                    "IfNotPresent",
                    "Never"
                  ]
                }
              }
            },
            "broker": {
              "type": "object",
              "properties": {
                "image": {
                  "$ref": "#/definitions/image"
                },
                "resources": {
                  "$ref": "#/definitions/resources"
                },
                "extraEnv": {
                  "$ref": "#/definitions/envList"
                }
              }
            }
          }
        }
      },
      "if": {
        "properties": {
          "size": {
            "const": "custom"
          }
        }
      },
      "then": {
        "required": [
          "advertise",
          "controllerResources"
        ],
        "properties": {
          "advertise": {
            "required": [
              "cpu",
              "memory"
            ],
            "properties": {
              "cpu": {
                "type": "integer"
              },
              "memory": {
                "minLength": 1
              }
            }
          },
          "controllerResources": {
            "required": [
              "limits"
            ],
            "properties": {
              "limits": {
                "required": [
                  "cpu",
                  "memory"
                ]
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "scaler": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "allOf": [
            {
              "$ref": "#/definitions/image"
            },
            {
              "required": [
                "repository"
              ],
              "properties": {
                "repository": {
                  "minLength": 1
                }
              }
            }
          ]
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "min": {
          "$ref": "#/definitions/positiveInt"
        },
        "max": {
          "$ref": "#/definitions/positiveInt"
        },
        "headroomPct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "idleSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "parkTTL": {
          "$ref": "#/definitions/positiveInt"
        },
        "stuckSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "settleTimeout": {
          "type": "integer",
          "minimum": 0
        },
        "interval": {
          "$ref": "#/definitions/positiveInt"
        },
        "extraEnv": {
          "type": "array"
        },
        "metrics": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "serviceMonitor": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "interval": {
                  "type": "string"
                },
                "labels": {
                  "type": "object"
                }
              }
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "leaderElection": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "nudge": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "string",
              "minLength": 1
            },
            "cooldownSeconds": {
              "type": "integer",
              "minimum": 30
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "clusterCIDRs": {
          "type": "array",
          "items": {
            "type": "string",
            "anyOf": [
              {
                "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}$"
              },
              {
                "pattern": "^[0-9a-fA-F:]+/[0-9]{1,3}$"
              }
            ]
          }
        },
        "blockMetadata": {
          "type": "boolean"
        },
        "allowClusterDNS": {
          "type": "boolean"
        },
        "dnsSelector": {
          "type": "object"
        },
        "extraEgress": {
          "type": "array"
        },
        "blockMetadataIPv6": {
          "type": "boolean"
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      },
      "then": {
        "properties": {
          "clusterCIDRs": {
            "minItems": 1
          }
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "uninstall": {
      "type": "object",
      "properties": {
        "deregister": {
          "type": "boolean"
        },
        "activeDeadlineSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 60
        },
        "resources": {
          "type": "object"
        }
      }
    }
  }
}
