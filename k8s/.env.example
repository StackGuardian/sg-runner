# Copy to k8s/.env (gitignored) and fill in. Use a throwaway runner group.
# `make secret` puts only SG_NODE_TOKEN in a Secret; `make up` passes the rest
# as chart values (sg.*), which the chart keeps in a ConfigMap.
SG_NODE_TOKEN=
SG_ORGANIZATION=
SG_RUNNER_GROUP=
SG_BASE_API=https://api.app.stackguardian.io/api/v1
