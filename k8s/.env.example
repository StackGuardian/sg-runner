# Copy to k8s/.env (gitignored) and fill in. Use a throwaway runner group.
SG_NODE_TOKEN=
SG_ORGANIZATION=
SG_RUNNER_GROUP=
SG_BASE_API=https://api.app.stackguardian.io/api/v1
# Optional: SG API key allowed to manage this runner group. Lets the pod set
# itself DRAINING/ACTIVE through SG (runner_status API) on shutdown/restart.
SG_API_KEY=
